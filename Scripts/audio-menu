#!/usr/bin/env python3
# Popup menu for choosing the default audio device, opened from waybar
# (right click on the wireplumber modules). Appears right under the bar at the
# pointer and is styled by waybar's style.css (see the "Audio menu" section).
#
#   audio-menu sink|source
#
# Enter/click picks a device, Escape or a click anywhere else closes the menu.

import json
import os
import subprocess
import sys

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, Gtk, GtkLayerShell  # noqa: E402

STYLE = os.path.expanduser("~/.config/waybar/style.css")


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def get_devices(kind):
    """[(node name, label, is default)]"""
    default = run("pactl", f"get-default-{kind}").strip()
    devices = json.loads(run("pactl", "-f", "json", "list", f"{kind}s"))
    # Every sink also has a "monitor" source, those are not inputs
    devices = [d for d in devices if d["properties"].get("device.class") != "monitor"]
    # Nothing is plugged in (HDMI without a display, empty headset jack)
    devices = [
        d
        for d in devices
        if not d["ports"] or any(p["availability"] != "not available" for p in d["ports"])
    ]

    # "Speaker" instead of "<long card name> Speaker", unless that is ambiguous
    short = [d["properties"].get("device.profile.description") for d in devices]
    labels = [
        sh if sh and short.count(sh) == 1 else d["description"]
        for d, sh in zip(devices, short)
    ]
    return [(d["name"], label, d["name"] == default) for d, label in zip(devices, labels)]


def pointer():
    """Pointer position, top-left corner and reserved top edge (the bar) of its monitor."""
    x, y = (int(v) for v in run("hyprctl", "cursorpos").split(","))
    for m in json.loads(run("hyprctl", "monitors", "-j")):
        width, height = m["width"] / m["scale"], m["height"] / m["scale"]
        if m["x"] <= x < m["x"] + width and m["y"] <= y < m["y"] + height:
            return x, m["x"], m["y"], m["reserved"][1]
    return x, 0, 0, 0


def gdk_monitor(x, y):
    display = Gdk.Display.get_default()
    for i in range(display.get_n_monitors()):
        monitor = display.get_monitor(i)
        geometry = monitor.get_geometry()
        if (geometry.x, geometry.y) == (x, y):
            return monitor
    return None


def main():
    kind = sys.argv[1] if len(sys.argv) > 1 else "sink"
    if kind not in ("sink", "source"):
        sys.exit(f"Usage: {sys.argv[0]} sink|source")
    devices = get_devices(kind)
    pointer_x, monitor_x, monitor_y, bar_height = pointer()
    monitor = gdk_monitor(monitor_x, monitor_y)

    provider = Gtk.CssProvider()
    provider.load_from_path(STYLE)
    screen = Gdk.Screen.get_default()
    Gtk.StyleContext.add_provider_for_screen(
        screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    # Transparent window over the whole monitor, so that a click outside of
    # the menu lands on it and closes the menu.
    window = Gtk.Window(name="audio-menu")
    window.set_visual(screen.get_rgba_visual())
    window.set_app_paintable(True)

    GtkLayerShell.init_for_window(window)
    GtkLayerShell.set_namespace(window, "audio-menu")
    GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_exclusive_zone(window, -1)
    GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.EXCLUSIVE)
    for edge in (
        GtkLayerShell.Edge.TOP,
        GtkLayerShell.Edge.BOTTOM,
        GtkLayerShell.Edge.LEFT,
        GtkLayerShell.Edge.RIGHT,
    ):
        GtkLayerShell.set_anchor(window, edge, True)
    if monitor:
        GtkLayerShell.set_monitor(window, monitor)

    menu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    menu.get_style_context().add_class("menu")
    menu.get_style_context().add_class(kind)
    menu.set_halign(Gtk.Align.START)
    menu.set_valign(Gtk.Align.START)

    def choose(_button, name):
        subprocess.run(["pactl", f"set-default-{kind}", name])
        Gtk.main_quit()

    current = None
    for name, label, is_default in devices:
        button = Gtk.Button()
        button.add(Gtk.Label(label=label, xalign=0))
        button.connect("clicked", choose, name)
        if is_default:
            button.get_style_context().add_class("current")
            current = button
        menu.pack_start(button, False, False, 0)
    if not devices:
        menu.pack_start(Gtk.Label(label=f"No {kind}s"), False, False, 0)

    # Centered under the pointer, kept inside the monitor
    menu.show_all()
    menu_width = menu.get_preferred_width()[1]
    monitor_width = monitor.get_geometry().width if monitor else screen.get_width()
    left = pointer_x - monitor_x - menu_width // 2
    menu.set_margin_start(max(0, min(left, monitor_width - menu_width)))
    menu.set_margin_top(bar_height)
    window.add(menu)

    def on_key(_window, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()

    window.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    window.connect("button-press-event", lambda *_: Gtk.main_quit())
    window.connect("key-press-event", on_key)
    window.connect("destroy", Gtk.main_quit)

    window.show_all()
    if current:
        current.grab_focus()
    Gtk.main()


if __name__ == "__main__":
    main()
